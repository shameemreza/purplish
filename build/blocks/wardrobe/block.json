{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purplish/wardrobe",
  "version": "1.3.0",
  "title": "Wardrobe",
  "category": "purplish",
  "parent": [
    "core/navigation"
  ],
  "description": "A menu item that opens a big panel of blocks: category links, photo tiles, a look. Goes inside the Navigation block.",
  "keywords": [
    "mega menu",
    "dropdown",
    "menu panel",
    "submenu",
    "navigation"
  ],
  "textdomain": "purplish",
  "attributes": {
    "label": {
      "type": "string",
      "role": "content",
      "default": ""
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "width": {
      "type": "string",
      "enum": [
        "wide",
        "content",
        "full"
      ],
      "default": "wide"
    },
    "look": {
      "type": "string",
      "enum": [
        "card",
        "flat"
      ],
      "default": "card"
    }
  },
  "usesContext": [
    "submenuVisibility",
    "openSubmenusOnClick",
    "showSubmenuIcon"
  ],
  "supports": {
    "html": false,
    "reusable": false
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css"
}