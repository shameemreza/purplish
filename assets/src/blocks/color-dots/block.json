{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purplish/color-dots",
	"version": "1.3.0",
	"title": "Color Dots",
	"category": "purplish",
	"description": "Shows the colors a product comes in, as small dots or swatches on product cards. Colors come from the color attribute or the Purplish page color of each variation.",
	"keywords": [ "swatches", "colors", "variations", "colorways" ],
	"textdomain": "purplish",
	"ancestor": [
		"woocommerce/product-template",
		"core/post-template",
		"woocommerce/single-product"
	],
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"look": {
			"type": "string",
			"enum": [ "dots", "swatches" ],
			"default": "dots"
		},
		"limit": {
			"type": "number",
			"default": 4
		},
		"single": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": false,
			"text": true
		},
		"typography": {
			"fontSize": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"example": {
		"attributes": {
			"look": "dots"
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
