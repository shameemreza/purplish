{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purplish/scroll-lookbook",
  "version": "1.1.0",
  "title": "Scroll Lookbook",
  "category": "purplish",
  "description": "Videos or photos play as visitors scroll, and at each stop that product's card slides in with add to cart.",
  "keywords": [
    "products",
    "lookbook",
    "video",
    "cover",
    "film"
  ],
  "textdomain": "purplish",
  "attributes": {
    "chapters": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ],
      "default": "on"
    },
    "timecode": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ],
      "default": "off"
    },
    "length": {
      "type": "string",
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "default": "medium"
    }
  },
  "allowedBlocks": [
    "core/cover",
    "woocommerce/product-collection",
    "core/group"
  ],
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ]
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./style-index.css"
}