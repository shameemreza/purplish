{
	"name": "shameemreza/purplish",
	"description": "Design options for the WooCommerce product page, added to WooCommerce's own blocks. Works with block and classic themes.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"wp-phpunit/wp-phpunit": "7.1.*",
		"wp-coding-standards/wpcs": "^3.1",
		"woocommerce/woocommerce-sniffs": "^2.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload-dev": {
		"psr-4": {
			"Purplish\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4.33"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"phpcs": "phpcs",
		"phpcbf": "phpcbf",
		"lint:compat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 7.4- --extensions=php src purplish.php uninstall.php",
		"test": "phpunit"
	}
}
