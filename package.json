{
	"name": "purplish",
	"version": "1.0.0",
	"private": true,
	"description": "A block design toolkit for your WooCommerce store. Style the product page, gallery and product cards in the block sidebar. Works with block and classic themes.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --source-path=assets/src --output-path=build --blocks-manifest",
		"start": "wp-scripts start --source-path=assets/src --output-path=build --blocks-manifest",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style 'assets/src/**/*.css' --allow-empty-input",
		"test:js": "wp-scripts test-unit-jest"
	},
	"devDependencies": {
		"@jest/globals": "30.5.2",
		"@wordpress/scripts": "36.0.0",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2"
	},
	"dependencies": {
		"@wordpress/components": "41.0.0",
		"@wordpress/compose": "8.9.0",
		"@wordpress/hooks": "4.56.0",
		"@wordpress/i18n": "6.29.0"
	}
}
