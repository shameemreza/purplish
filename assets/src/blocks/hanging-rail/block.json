{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purplish/hanging-rail",
	"version": "1.1.0",
	"title": "Hanging Rail",
	"category": "purplish",
	"description": "Products hang from clips on a rope and slide along it as the page scrolls.",
	"keywords": [ "products", "carousel", "clothesline", "scroll" ],
	"textdomain": "purplish",
	"attributes": {
		"clip": {
			"type": "string",
			"enum": [ "peg", "binder", "tape" ],
			"default": "peg"
		},
		"sag": {
			"type": "string",
			"enum": [ "little", "more" ],
			"default": "little"
		},
		"length": {
			"type": "string",
			"enum": [ "short", "medium", "long" ],
			"default": "medium"
		}
	},
	"allowedBlocks": [
		"woocommerce/product-collection",
		"core/heading",
		"core/paragraph"
	],
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": [ "top", "bottom" ],
			"padding": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css"
}
