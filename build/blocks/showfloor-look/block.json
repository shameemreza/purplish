{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purplish/showfloor-look",
  "version": "1.3.0",
  "title": "Look",
  "category": "purplish",
  "parent": [
    "purplish/showfloor"
  ],
  "description": "One look on the Showfloor: a cut-out image, a name, a short line and the products in it.",
  "textdomain": "purplish",
  "attributes": {
    "id": {
      "type": "number",
      "default": 0
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "line": {
      "type": "string",
      "default": ""
    },
    "products": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "marks": {
      "type": "object",
      "default": {}
    },
    "face": {
      "type": "object",
      "default": {
        "x": 0.5,
        "y": 0.07
      }
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": false
  }
}