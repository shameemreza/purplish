{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purplish/step-path",
  "version": "1.2.0",
  "title": "Step Path",
  "category": "purplish",
  "description": "Numbered steps on a line that draws as the block scrolls into view.",
  "keywords": [
    "steps",
    "process",
    "timeline",
    "how it works"
  ],
  "textdomain": "purplish",
  "attributes": {
    "direction": {
      "type": "string",
      "enum": [
        "across",
        "down"
      ],
      "default": "across"
    },
    "marker": {
      "type": "string",
      "enum": [
        "numbers",
        "dots"
      ],
      "default": "numbers"
    },
    "line": {
      "type": "string",
      "enum": [
        "plain",
        "dashed"
      ],
      "default": "plain"
    }
  },
  "allowedBlocks": [
    "core/group"
  ],
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}