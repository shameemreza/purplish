{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "purplish/shelf-tag",
  "version": "1.3.0",
  "title": "Shelf Tag",
  "category": "purplish",
  "description": "A small tag on product cards, such as New arrival or Best seller. It shows only on the products its rule matches, and sits on the photo inside the Product Image block.",
  "keywords": [
    "badge",
    "label",
    "new",
    "best seller",
    "featured"
  ],
  "textdomain": "purplish",
  "ancestor": [
    "woocommerce/product-template",
    "core/post-template",
    "woocommerce/single-product"
  ],
  "usesContext": [
    "postId",
    "postType"
  ],
  "attributes": {
    "rule": {
      "type": "string",
      "enum": [
        "bestseller",
        "new",
        "featured"
      ],
      "default": "bestseller"
    },
    "top": {
      "type": "number",
      "default": 8
    },
    "days": {
      "type": "number",
      "default": 30
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "look": {
      "type": "string",
      "enum": [
        "chip",
        "pill",
        "glass"
      ],
      "default": "chip"
    },
    "corner": {
      "type": "string",
      "enum": [
        "top-right",
        "top-left",
        "bottom-left",
        "bottom-right"
      ],
      "default": "top-right"
    },
    "shine": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "color": {
      "background": true,
      "text": true
    },
    "typography": {
      "fontSize": true,
      "__experimentalFontWeight": true,
      "__experimentalLetterSpacing": true,
      "__experimentalTextTransform": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": true
  },
  "example": {
    "attributes": {
      "rule": "bestseller"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}