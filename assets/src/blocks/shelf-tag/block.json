{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "purplish/shelf-tag",
	"version": "1.4.1",
	"title": "Shelf Tag",
	"category": "purplish",
	"description": "A small tag on product cards, such as New arrival, Best seller or a campaign. It shows only on the products its rule matches, and sits on the photo inside the Product Image block.",
	"keywords": [ "badge", "label", "ribbon", "campaign", "new", "best seller", "featured", "sale" ],
	"textdomain": "purplish",
	"ancestor": [
		"woocommerce/product-template",
		"core/post-template",
		"woocommerce/single-product"
	],
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"rule": {
			"type": "string",
			"enum": [ "bestseller", "new", "featured", "tag", "category", "sale" ],
			"default": "bestseller"
		},
		"top": {
			"type": "number",
			"default": 8
		},
		"days": {
			"type": "number",
			"default": 30
		},
		"term": {
			"type": "number",
			"default": 0
		},
		"from": {
			"type": "string",
			"default": ""
		},
		"until": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"look": {
			"type": "string",
			"enum": [ "chip", "pill", "glass", "ribbon", "image" ],
			"default": "chip"
		},
		"corner": {
			"type": "string",
			"enum": [ "top-right", "top-left", "bottom-left", "bottom-right" ],
			"default": "top-right"
		},
		"shine": {
			"type": "boolean",
			"default": false
		},
		"imageId": {
			"type": "number",
			"default": 0
		},
		"imageAlt": {
			"type": "string",
			"default": ""
		},
		"size": {
			"type": "string",
			"enum": [ "m", "s", "l" ],
			"default": "m"
		}
	},
	"supports": {
		"html": false,
		"reusable": false,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"__experimentalFontWeight": true,
			"__experimentalLetterSpacing": true,
			"__experimentalTextTransform": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": true,
		"interactivity": {
			"clientNavigation": true
		}
	},
	"example": {
		"attributes": {
			"rule": "bestseller"
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}
