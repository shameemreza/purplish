{
	"name": "purplish",
	"version": "1.0.0",
	"private": true,
	"description": "Design options for the WooCommerce product page, added to WooCommerce's own blocks. Works with block and classic themes.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build admin=./assets/src/admin/index.js editor=./assets/src/editor/index.js frontend=./assets/src/frontend/index.js --output-path=build",
		"start": "wp-scripts start admin=./assets/src/admin/index.js editor=./assets/src/editor/index.js frontend=./assets/src/frontend/index.js --output-path=build",
		"lint:js": "wp-scripts lint-js",
		"lint:css": "wp-scripts lint-style 'assets/src/**/*.css' --allow-empty-input",
		"test:js": "wp-scripts test-unit-jest"
	},
	"devDependencies": {
		"@jest/globals": "30.5.2",
		"@wordpress/scripts": "36.0.0",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2"
	}
}
